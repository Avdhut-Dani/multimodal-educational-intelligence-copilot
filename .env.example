# Multi-Modal Ingestion Configuration

# Application
APP_NAME="Multi-Modal Educational Data Ingestion Subsystem (Team 4a)"
DEBUG=false

# Qdrant Vector DB
# Set QDRANT_MODE to "embedded" for lightweight development, or "server" for Docker/production
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant_storage
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=education_materials

# Celery & Redis
# Set CELERY_ALWAYS_EAGER=true for lightweight development without Redis daemon
CELERY_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=v2.2.0
EMBEDDING_DIM=384
WHISPER_MODEL_SIZE=tiny

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=32

# Novelties
SLIDE_OCR_ENABLED=true
PDF_TABLE_EXTRACTION_ENABLED=true
SCENE_DETECTION_ENABLED=true
